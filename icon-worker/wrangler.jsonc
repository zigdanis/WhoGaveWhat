{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whogavewhat-icons",
  "main": "src/index.ts",
  "build": { "command": "npm run build:catalog" },
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  // The account comes from CLOUDFLARE_ACCOUNT_ID in the deploy workflow; this repository is public.
  "vars": {
    "JEV_MODEL": "jev-1.13.0",
    // Jev rejects requests above its default 64k-token context (the long-context header is never sent),
    // so this bounds the cost of any attempt, including ones whose usage is never reported.
    "JEV_MAX_REQUEST_TOKENS": "65536",
    "JEV_PRICE_PER_MTOK_USD": "0.042",
    "MIN_CONFIDENCE": "0.35",
    // How concentrated Jev's price probability is around the estimate: 0 for an even spread, 1 for all of it nearby.
    "MIN_PRICE_CONFIDENCE": "0.05",
    "MONTHLY_BUDGET_USD": "3",
    "DAILY_BUDGET_USD": "0.5",
    "PER_INSTALL_PER_DAY": "100",
    "PER_IP_PER_MINUTE": "30",
    "GLOBAL_PER_MINUTE": "120"
  },
  // JEV_API_KEY is a Worker secret, copied from the repository secret by the deploy workflow; never in this file.
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "IconLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IconLimiter"] }],
  // Only the Worker's own metric lines are kept; per-request invocation logs (URLs, headers) are off.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } }
}
