default_platform :ios
fastlane_require 'dotenv'

platform :ios do

  # Read-only: confirm the App Store Connect record exists before uploading.
  lane :check do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: ENV['ASC_KEY_PATH']
    )
    build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "pro.ziganshin.WhoGaveWhat",
      initial_build_number: 0
    )
    UI.message("ASC app record found. Latest TestFlight build: #{build}")
  end

  # List builds with their processing state (diagnostic).
  lane :builds do
    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: ENV['ASC_KEY_PATH']
    )
    require 'spaceship'
    token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      filepath: ENV['ASC_KEY_PATH']
    )
    Spaceship::ConnectAPI.token = token
    app = Spaceship::ConnectAPI::App.find("pro.ziganshin.WhoGaveWhat")
    UI.message("App: #{app.name} (#{app.id})")
    builds = app.get_builds(includes: "preReleaseVersion")
    if builds.empty?
      UI.important("No builds returned by API.")
    else
      builds.each do |b|
        UI.message("build #{b.version} | state=#{b.processing_state} | expired=#{b.expired} | uploaded=#{b.uploaded_date}")
      end
    end
  end

  # Run the unit-test suite on a simulator.
  lane :tests do
    run_tests(
      project: "WhoGaveWhat.xcodeproj",
      scheme: "WhoGaveWhat",
      devices: ["iPhone 17"]   # iOS 26 simulator
    )
  end

  # Build the app and upload it to TestFlight.
  lane :beta do
    # Gate the release on a green test run.
    tests

    api_key = app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_filepath: ENV['ASC_KEY_PATH']
    )

    # Fetch the App Store distribution certificate + provisioning profile.
    match(
      type: "appstore",
      readonly: false,
      api_key: api_key,
      app_identifier: ["pro.ziganshin.WhoGaveWhat"]
    )

    # Pick the next build number above whatever TestFlight already has.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "pro.ziganshin.WhoGaveWhat",
      initial_build_number: 0
    )
    new_build = latest + 1
    increment_build_number(build_number: new_build)

    gym(
      scheme: "WhoGaveWhat",
      export_method: "app-store"
    )

    # "What to Test" notes are mandatory for external distribution.
    # Summarize commits since the last TestFlight publish into EN + RU notes.
    localized_notes = whats_new_notes(commits_since_last_publish)

    pilot(
      api_key: api_key,
      # Per-locale "What to Test": English + Russian fields.
      localized_build_info: localized_notes,
      # Wait for processing, then push the build to the public beta group.
      distribute_external: true,
      groups: ["External"],
      notify_external_testers: true,
      beta_app_feedback_email: "zigdanis@gmail.com"
    )

    # Tag this commit so the next run diffs the changelog from here.
    mark_published(new_build)
  end

  # Raw changelog covering commits since the last TestFlight publish.
  # Relies on a git tag written after each successful upload; on the first run
  # (no such tag yet) it falls back to the last `fallback_count` commits.
  def commits_since_last_publish(fallback_count: 10)
    opts = { pretty: "- %s", merge_commit_filtering: "exclude_merges" }
    last_tag = sh(
      "git describe --tags --abbrev=0 --match 'testflight/*' 2>/dev/null || true",
      log: false
    ).strip

    if last_tag.empty?
      UI.message("No previous TestFlight tag; using last #{fallback_count} commits.")
      return changelog_from_git_commits(**opts, commits_count: fallback_count)
    end

    UI.message("Building changelog since #{last_tag}.")
    raw = changelog_from_git_commits(**opts, between: [last_tag, "HEAD"]).to_s.strip
    if raw.empty?
      UI.message("No commits since #{last_tag}; using last #{fallback_count} commits.")
      raw = changelog_from_git_commits(**opts, commits_count: fallback_count)
    end
    raw
  end

  # Tag the current commit so the next run knows where the last publish ended.
  def mark_published(build_number)
    tag = "testflight/#{build_number}"
    add_git_tag(tag: tag)
    push_git_tags
  rescue => e
    UI.important("Could not create/push tag #{tag} (#{e.message}); continuing.")
  end

  # Generate localized "What to Test" notes (EN + RU) from a raw changelog
  # via the local Claude Code CLI. Falls back to the raw text on any error.
  def whats_new_notes(raw)
    begin
      require 'open3'
      require 'json'

      prompt = <<~PROMPT
        You are writing TestFlight "What to Test" release notes from raw git commit messages.
        Summarize the changes into short, user-facing beta tester notes (max 4 bullet points,
        plain language, no internal jargon, no commit hashes). Then translate that summary to Russian.
        Respond with ONLY a minified JSON object, no markdown fences, exactly this shape:
        {"en":"<english>","ru":"<russian>"}

        Git commits:
        #{raw}
      PROMPT

      stdout, status = Open3.capture2(
        "claude", "-p", "--model", "claude-haiku-4-5",
        stdin_data: prompt
      )
      raise "claude CLI exited #{status.exitstatus}" unless status.success?

      text = stdout.strip
                   .sub(/\A```(?:json)?\s*/m, "")
                   .sub(/\s*```\z/m, "")
                   .strip
      data = JSON.parse(text)
      UI.success("Generated EN + RU 'What to Test' notes via Claude CLI.")
      { "en-US" => { whats_new: data.fetch("en") }, "ru" => { whats_new: data.fetch("ru") } }
    rescue => e
      UI.important("Claude CLI notes failed (#{e.message}); using raw changelog for both locales.")
      { "en-US" => { whats_new: raw }, "ru" => { whats_new: raw } }
    end
  end
end
