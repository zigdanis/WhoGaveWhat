    "settings.backup.export-footnote" : {
      "comment" : "Below the export and import rows when there is no iCloud backup.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export saves all your gifts, people and photos to one file. Import adds what is missing from such a file and never deletes anything."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт сохраняет все подарки, людей и фото в один файл. Импорт добавляет из такого файла то, чего не хватает, и ничего не удаляет."
          }
        }
      }
    },
    "settings.backup.footnote" : {
      "comment" : "Below the backup settings: what the iCloud backup keeps and where.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your gifts, people and photos are kept in your iCloud, so they stay safe if you delete the app or change phones. The backup doesn't appear in iCloud Drive."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подарки, люди и фото хранятся в вашем iCloud, поэтому не потеряются, если удалить приложение или сменить телефон. Копия не появляется в iCloud Drive."
          }
        }
      }
    },
